# Copy to .env and edit. docker compose reads .env automatically.
#
#   cp .env.example .env          (Windows: copy .env.example .env)

# --- inference -------------------------------------------------------------
# DRY_RUN=1 uses the dummy segmenter: no weights, no GPU, meaningless masks.
# It is the default so that `docker compose up` works on a fresh machine.
# Set to 0 once ./checkpoints/MedSAM2_CTLesion.pt is in place.
DRY_RUN=1

# cpu or cuda. The GPU overlay sets cuda for the worker regardless.
DEVICE=cpu

# Seconds before a queued job is abandoned. CPU inference is slow; leave room.
JOB_TIMEOUT=600

# --- ports -----------------------------------------------------------------
API_PORT=8000
UI_PORT=8501

# --- database --------------------------------------------------------------
# Local development values. Change them for anything reachable from a network.
POSTGRES_USER=nodule
POSTGRES_PASSWORD=nodule
POSTGRES_DB=nodule
